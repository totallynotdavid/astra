{
  "name": "@astra/web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --bun vite",
    "build": "tsc && bun --bun vite build",
    "build:site": "tsc && VITE_ASTRA_SOURCE=static bun --bun vite build --base ./ --outDir dist-site",
    "preview": "bun --bun vite preview",
    "typecheck": "tsc",
    "test": "bun --bun vitest run",
    "test:e2e": "bun --bun vitest run --config vitest.e2e.config.ts",
    "lint": "oxlint --deny-warnings --jsx-a11y-plugin src"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.71.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/dom": "10",
    "@testing-library/react": "16",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "happy-dom": "18",
    "oxlint": "^1.93.0",
    "playwright-core": "^1.65.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
